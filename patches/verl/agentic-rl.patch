+_AGENT_LOOP_DISTRIBUTIONS = {
+    "assistant_turns": "rollout/assistant_turns",
+    "user_turns": "rollout/user_turns",
+    "tool_call_count": "rollout/tool_call_count",
+    "num_errors": "rollout/errors",
+    "prompt_tokens": "rollout/prompt_tokens",
+    "response_tokens": "rollout/response_tokens",
+    "assistant_tokens": "rollout/assistant_tokens",
+    "observation_tokens": "rollout/observation_tokens",
+    "user_observation_tokens": "rollout/user_observation_tokens",
+    "tool_response_tokens": "rollout/tool_response_tokens",
+    "assistant_tokens_per_turn": "rollout/assistant_tokens_per_turn",
+    "tool_response_tokens_per_call": "rollout/tool_response_tokens_per_call",
+    "trajectory_seconds": "rollout/trajectory_seconds",
+    "generation_seconds": "rollout/generation_seconds",
+    "user_seconds": "rollout/user_seconds",
+    "tool_seconds": "rollout/tool_seconds",
+    "evaluation_seconds": "rollout/evaluation_seconds",
+    "turn_credit_target_field_count": "turn_credit/target_field_count",
+    "turn_credit_final_potential": "turn_credit/final_potential",
+    "turn_credit_best_potential": "turn_credit/best_potential",
+    "turn_credit_total_new_progress": "turn_credit/total_new_progress",
+    "turn_credit_positive_progress_turns": "turn_credit/positive_progress_turns",
+    "turn_credit_target_fact_count": "turn_credit/target_fact_count",
+    "turn_credit_covered_fact_count": "turn_credit/covered_fact_count",
+    "turn_credit_final_fact_potential": "turn_credit/final_fact_potential",
+    "turn_credit_best_fact_potential": "turn_credit/best_fact_potential",
+    "turn_credit_total_new_fact_progress": "turn_credit/total_new_fact_progress",
+    "turn_credit_positive_fact_progress_turns": "turn_credit/positive_fact_progress_turns",
+    "turn_credit_model_error_turns": "turn_credit/model_error_turns",
+}
+
+
+def _sequence_scores(batch: DataProto) -> np.ndarray:
+    scores = batch.batch["token_level_scores"].sum(-1)
+    return scores.detach().float().cpu().numpy()
+
+
+def _numeric_values(batch: DataProto, key: str) -> np.ndarray | None:
+    values = batch.non_tensor_batch.get(key)
+    if values is None:
+        return None
+    return np.asarray(values, dtype=np.float64)
+
+
+def _group_indices(batch: DataProto) -> list[np.ndarray]:
+    group_ids = batch.non_tensor_batch.get("uid")
+    if group_ids is None:
+        group_ids = batch.non_tensor_batch.get("task_id")
+    if group_ids is None:
+        return []
+
+    normalized_ids = np.asarray(group_ids).astype(str)
+    return [np.flatnonzero(normalized_ids == group_id) for group_id in dict.fromkeys(normalized_ids)]
+
+
+def _sample_has_local_signal(spans: list[dict[str, Any]]) -> bool:
+    return any(
+        float(span["new_progress"]) != 0.0
+        or float(span.get("new_fact_progress", 0.0)) != 0.0
+        or bool(span["model_error"])
+        for span in spans
+    )
+
+
+def compute_agent_loop_metrics(batch: DataProto) -> dict[str, float]:
+    """Summarize sequence-level AgentLoop and GRPO signal metrics."""
+
+    scores = _sequence_scores(batch)
+    success_mask = scores > 0.5
+    metrics = {
+        "reward/success_count": float(success_mask.sum()),
+        "reward/failure_count": float((~success_mask).sum()),
+        "reward/success_rate": float(success_mask.mean()),
+        "rollout/valid_trajectories": float(len(scores)),
+    }
+
+    groups = _group_indices(batch)
+    if groups:
+        group_rewards = [scores[indices] for indices in groups]
+        group_means = np.asarray([rewards.mean() for rewards in group_rewards])
+        outcome_signal = np.asarray([np.unique(rewards).size > 1 for rewards in group_rewards])
+
+        turn_credit_spans = batch.non_tensor_batch.get("turn_credit_spans")
+        if turn_credit_spans is None:
+            sample_has_local_signal = np.zeros(len(scores), dtype=bool)
+        else:
+            sample_has_local_signal = np.asarray(
+                [_sample_has_local_signal(spans) for spans in turn_credit_spans],
+                dtype=bool,
+            )
+        local_signal = np.asarray(
+            [sample_has_local_signal[indices].any() for indices in groups],
+            dtype=bool,
+        )
+
+        advantages = batch.batch.get("advantages")
+        response_mask = batch.batch.get("response_mask")
+        if advantages is not None and response_mask is not None:
+            active_advantages = advantages.detach().float().abs() * response_mask
+            sample_has_effective_signal = active_advantages.gt(1e-8).any(dim=-1).cpu().numpy()
+            effective_signal = np.asarray(
+                [sample_has_effective_signal[indices].any() for indices in groups],
+                dtype=bool,
+            )
+        else:
+            effective_signal = outcome_signal | local_signal
+
+        metrics.update(
+            {
+                "grpo/group_count": float(len(groups)),
+                "grpo/mixed_group_count": float(outcome_signal.sum()),
+                "grpo/mixed_group_ratio": float(outcome_signal.mean()),
+                "grpo/zero_signal_group_count": float((~outcome_signal).sum()),
+                "grpo/outcome_signal_group_count": float(outcome_signal.sum()),
+                "grpo/outcome_signal_group_ratio": float(outcome_signal.mean()),
+                "grpo/local_signal_group_count": float(local_signal.sum()),
+                "grpo/local_signal_group_ratio": float(local_signal.mean()),
+                "grpo/effective_signal_group_count": float(effective_signal.sum()),
+                "grpo/effective_signal_group_ratio": float(effective_signal.mean()),
+                "grpo/group_reward_mean_min": float(group_means.min()),
+                "grpo/group_reward_mean_max": float(group_means.max()),
+                "grpo/group_reward_mean": float(group_means.mean()),
+            }
+        )
+
+    for source_key, metric_prefix in _AGENT_LOOP_DISTRIBUTIONS.items():
+        values = _numeric_values(batch, source_key)
+        if values is None:
+            continue
+        metrics[f"{metric_prefix}/mean"] = float(values.mean())
+        metrics[f"{metric_prefix}/p90"] = float(np.percentile(values, 90))
+        metrics[f"{metric_prefix}/max"] = float(values.max())
+
+    retry_counts = _numeric_values(batch, "infrastructure_retry_count")
+    if retry_counts is not None:
+        metrics["infra/retry_attempt_count"] = float(retry_counts.sum())
+        metrics["infra/retried_trajectory_count"] = float((retry_counts > 0).sum())
+
+    preempted = _numeric_values(batch, "num_preempted")
+    if preempted is not None:
+        metrics["rollout/num_preempted"] = float(preempted.sum())
+
+    assistant_tokens = _numeric_values(batch, "assistant_tokens")
+    response_tokens = _numeric_values(batch, "response_tokens")
+    if assistant_tokens is not None and response_tokens is not None and response_tokens.sum() > 0:
+        metrics["rollout/assistant_token_fraction"] = float(assistant_tokens.sum() / response_tokens.sum())
+
+    termination_reasons = batch.non_tensor_batch.get("termination_reason")
+    if termination_reasons is not None:
+        reasons, counts = np.unique(
+            np.asarray(termination_reasons).astype(str),
+            return_counts=True,
+        )
+        for reason, count in zip(reasons, counts, strict=True):
+            metric_reason = reason.replace("-", "_").replace(" ", "_")
+            metrics[f"termination/{metric_reason}_count"] = float(count)
+
+    return metrics
+
+
+def build_grpo_group_table(
+    batch: DataProto,
+    *,
+    step: int,
+    num_rollouts: int,
+) -> tuple[list[str], list[list[Any]]]:
+    """Build one compact row per GRPO prompt group."""
+
+    columns = ["step", "task_id", "group_id", *[f"reward_{index}" for index in range(num_rollouts)]]
+    columns.extend(["group_size", "mean_reward", "reward_std", "mixed"])
+    scores = _sequence_scores(batch)
+    task_ids = np.asarray(batch.non_tensor_batch.get("task_id", [None] * len(scores)))
+    rollout_indices = np.asarray(batch.non_tensor_batch.get("rollout_index", np.arange(len(scores))), dtype=int)
+    group_ids = np.asarray(batch.non_tensor_batch.get("uid", task_ids)).astype(str)
+
+    rows = []
+    for group_id in dict.fromkeys(group_ids):
+        indices = np.flatnonzero(group_ids == group_id)
+        reward_slots: list[float | None] = [None] * num_rollouts
+        for index in indices:
+            rollout_index = int(rollout_indices[index])
+            if 0 <= rollout_index < num_rollouts:
+                reward_slots[rollout_index] = float(scores[index])
+        rewards = scores[indices]
+        rows.append(
+            [
+                step,
+                str(task_ids[indices[0]]),
+                group_id,
+                *reward_slots,
+                len(indices),
+                float(rewards.mean()),
+                float(rewards.std(ddof=1)) if len(rewards) > 1 else 0.0,
+                bool(np.unique(rewards).size > 1),
+            ]
+        )
+    return columns, rows
+
+
+def build_agent_loop_trajectory_table(batch: DataProto, *, step: int) -> tuple[list[str], list[list[Any]]]:
+    """Build metadata-only trajectory rows without uploading conversation text."""
+
+    fields = [
+        "task_id",
+        "rollout_index",
+        "slot_id",
+        "termination_reason",
+        "assistant_turns",
+        "user_turns",
+        "tool_call_count",
+        "num_errors",
+        "assistant_tokens",
+        "observation_tokens",
+        "user_observation_tokens",
+        "tool_response_tokens",
+        "assistant_tokens_per_turn",
+        "tool_response_tokens_per_call",
+        "trajectory_seconds",
+        "generation_seconds",
+        "user_seconds",
+        "num_preempted",
+        "infrastructure_retry_count",
+        "turn_credit_target_field_count",
+        "turn_credit_final_potential",
+        "turn_credit_best_potential",
+        "turn_credit_total_new_progress",
+        "turn_credit_positive_progress_turns",
+        "turn_credit_target_fact_count",
+        "turn_credit_covered_fact_count",
+        "turn_credit_final_fact_potential",
+        "turn_credit_best_fact_potential",
+        "turn_credit_total_new_fact_progress",
+        "turn_credit_positive_fact_progress_turns",
+        "turn_credit_model_error_turns",
+    ]
+    scores = _sequence_scores(batch)
+    columns = ["step", "reward", *fields]
+    rows = []
+    for index, score in enumerate(scores):
+        row = [step, float(score)]
+        for field in fields:
+            values = batch.non_tensor_batch.get(field)
+            value = None if values is None else values[index]
+            row.append(value.item() if isinstance(value, np.generic) else value)
+        rows.append(row)
+    return columns, rows
+
+
+def format_agent_loop_step_summary(metrics: dict[str, Any], *, step: int) -> str:
+    """Render two short terminal lines for a completed training step."""
+
+    successes = int(metrics.get("reward/success_count", 0))
+    trajectories = int(metrics.get("rollout/valid_trajectories", 0))
+    mixed = int(metrics.get("grpo/mixed_group_count", 0))
+    groups = int(metrics.get("grpo/group_count", 0))
+    retries = int(metrics.get("infra/retry_attempt_count", 0))
+    rollout_seconds = float(metrics.get("timing_s/gen", 0.0))
+    reference_seconds = float(metrics.get("timing_s/ref", 0.0))
+    actor_seconds = float(metrics.get("timing_s/update_actor", 0.0))
+    kl_loss = float(metrics.get("actor/kl_loss", 0.0))
+    sync_seconds = float(metrics.get("timing_s/update_weights", 0.0))
+    checkpoint_seconds = float(metrics.get("timing_s/save_checkpoint", 0.0))
