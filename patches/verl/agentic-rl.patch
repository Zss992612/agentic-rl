+import copy
+
+import torch
+from transformers import AutoModelForCausalLM, Qwen3Config
+
+from verl.models.transformers.dense_common import forward_with_torch_backend
+from verl.workers.actor.dp_actor import _assistant_target_positions, _restore_response_values
+
+
+def _tiny_qwen3() -> torch.nn.Module:
+    config = Qwen3Config(
+        vocab_size=97,
+        hidden_size=32,
+        intermediate_size=64,
+        num_hidden_layers=2,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=8,
+        max_position_embeddings=64,
+        use_cache=False,
+    )
+    return AutoModelForCausalLM.from_config(config, torch_dtype=torch.float32)
+
+
+def test_assistant_only_lm_head_matches_dense_log_probs_and_gradients():
+    torch.manual_seed(7)
+    reference_model = _tiny_qwen3().eval()
+    optimized_model = copy.deepcopy(reference_model).eval()
+
+    input_ids = torch.randint(0, 97, (2, 9))
+    attention_mask = torch.ones_like(input_ids)
+    position_ids = torch.arange(input_ids.shape[1]).expand_as(input_ids)
+    responses = input_ids[:, -4:]
+    response_mask = torch.tensor([[1, 0, 1, 1], [0, 1, 1, 0]], dtype=torch.bool)
+    predictor_mask = _assistant_target_positions(input_ids, response_mask)
+    target_token_ids = responses[response_mask]
+    loss_weights = torch.tensor([0.2, -0.4, 0.8, 0.3, -0.7])
+
+    reference_logits = reference_model(
+        input_ids=input_ids,
+        attention_mask=attention_mask,
+        position_ids=position_ids,
+        use_cache=False,
+    ).logits[predictor_mask]
+    reference_log_probs = reference_logits.log_softmax(dim=-1).gather(
+        -1, target_token_ids.unsqueeze(-1)
+    ).squeeze(-1)
+
+    optimized_output = forward_with_torch_backend(
+        optimized_model,
+        input_ids=input_ids,
+        attention_mask=attention_mask,
+        position_ids=position_ids,
+        use_cache=False,
+        return_dict=True,
+        logits_mask=predictor_mask,
+        target_token_ids=target_token_ids,
+        calculate_entropy=False,
+    )
+
+    assert optimized_output.entropy is None
+    torch.testing.assert_close(optimized_output.log_probs, reference_log_probs, atol=1e-5, rtol=1e-5)
+
+    (reference_log_probs * loss_weights).sum().backward()
+    (optimized_output.log_probs * loss_weights).sum().backward()
+    for (_, reference_parameter), (_, optimized_parameter) in zip(
+        reference_model.named_parameters(), optimized_model.named_parameters(), strict=True
+    ):
+        if reference_parameter.grad is None:
+            assert optimized_parameter.grad is None
+        else:
+            torch.testing.assert_close(
+                optimized_parameter.grad,
+                reference_parameter.grad,
+                atol=2e-5,
+                rtol=2e-5,
+            )
+
+    restored = _restore_response_values(optimized_output.log_probs, response_mask)
+    assert restored.shape == response_mask.shape
+    torch.testing.assert_close(restored[response_mask], optimized_output.log_probs)
+    assert torch.count_nonzero(restored[~response_mask]) == 0
